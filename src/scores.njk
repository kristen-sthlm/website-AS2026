---
pagination:
  data: collections.hymns
  size: 1
  alias: hymn
permalink: "/hymns/{{ hymn.number | pad3 }}-score/"
eleventyComputed:
  title: "Noter — Sång {{ hymn.number }}"
  lang: "sv"
layout: base.njk
---

{% set padded = hymn.number | pad3 %}
{% set t = strings.sv %}
{% set sv = hymn.languages.sv %}

{# Find prev/next score in the sorted collection #}
{% set prevHymn = null %}
{% set nextHymn = null %}
{% set foundIdx = -1 %}
{% for h in collections.hymns %}
  {% if h.number == hymn.number %}
    {% set foundIdx = loop.index0 %}
  {% endif %}
{% endfor %}
{% for h in collections.hymns %}
  {% if loop.index0 == foundIdx - 1 %}{% set prevHymn = h %}{% endif %}
  {% if loop.index0 == foundIdx + 1 %}{% set nextHymn = h %}{% endif %}
{% endfor %}

<article class="score-page" data-padded="{{ padded }}">
  <div class="hymn-topbar">
    <a href="{{ '/' | url }}" class="icon-btn" aria-label="{{ t.home or 'Innehåll' }}" title="{{ t.home or 'Innehåll' }}">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 9.5L10 3l7 6.5V17a1 1 0 0 1-1 1h-3v-5H8v5H4a1 1 0 0 1-1-1V9.5z"/>
      </svg>
    </a>

    <div class="hymn-number-group">
      {% if prevHymn %}
        {% set prevPadded = prevHymn.number | pad3 %}
        <a href="{{ ('/hymns/' + prevPadded + '-score/') | url }}" class="nav-arrow" aria-label="Föregående noter ({{ prevHymn.number }})" title="Föregående">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4l-6 6 6 6"/>
          </svg>
        </a>
      {% else %}
        <span class="nav-arrow is-disabled" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4l-6 6 6 6"/>
          </svg>
        </span>
      {% endif %}

      <input
        type="number"
        class="hymn-number-large"
        value="{{ hymn.number }}"
        min="1"
        max="{{ collections.hymns.length }}"
        inputmode="numeric"
        pattern="[0-9]*"
        aria-label="Gå till noter"
        data-target="score"
      >

      {% if nextHymn %}
        {% set nextPadded = nextHymn.number | pad3 %}
        <a href="{{ ('/hymns/' + nextPadded + '-score/') | url }}" class="nav-arrow" aria-label="Nästa noter ({{ nextHymn.number }})" title="Nästa">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 4l6 6-6 6"/>
          </svg>
        </a>
      {% else %}
        <span class="nav-arrow is-disabled" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 4l6 6-6 6"/>
          </svg>
        </span>
      {% endif %}
    </div>

    <a href="{{ sv.url | url }}" class="icon-btn" aria-label="{{ t.backToHymn }}" title="{{ t.backToHymn }}">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 3h7l4 4v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/>
        <path d="M12 3v4h4"/>
        <path d="M7 11h6M7 14h6"/>
      </svg>
    </a>
  </div>

  {% set hymnTitle = '' %}
  {% if hymn.verses and hymn.verses[0] %}
    {% set hymnTitle = hymn.verses[0].firstLine %}
  {% endif %}

  <section class="audio-section">
    <div class="player" data-src="{{ ('/hymns/audio/' + padded + '.mp3') | url }}" data-title="{{ hymnTitle }}">
      <div class="player-title" aria-hidden="true">{{ hymnTitle }}</div>
      <div class="player-row">
        <button type="button" class="player-play" aria-label="Spela">
          <svg class="player-icon-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M8 5.5v13a1 1 0 0 0 1.55.83l10-6.5a1 1 0 0 0 0-1.66l-10-6.5A1 1 0 0 0 8 5.5z"/>
          </svg>
          <svg class="player-icon-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <rect x="6" y="5" width="4.5" height="14" rx="1"/>
            <rect x="13.5" y="5" width="4.5" height="14" rx="1"/>
          </svg>
        </button>
        <div class="player-progress" role="slider" tabindex="0" aria-label="Spelningsläge" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="player-progress-track">
            <div class="player-progress-fill"></div>
            <div class="player-progress-thumb"></div>
          </div>
        </div>
        <div class="player-time">
          <span class="player-time-current">0:00</span>
          <span class="player-time-sep">/</span>
          <span class="player-time-total">—</span>
        </div>
        <button type="button" class="player-loop is-active" aria-label="Loop" aria-pressed="true" title="Upprepa">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 8a3 3 0 0 1 3-3h7l-2-2M15 12a3 3 0 0 1-3 3H5l2 2"/>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <div class="score">
    {% set pages = padded | scorePageCount %}
    {% for n in range(1, pages + 1) %}
      {% set imgPath = '/hymns/scores/' + padded + '-' + (n | string) + '.png' %}
      <div class="score-img-wrap">
        <img src="{{ imgPath | url }}" alt="Sida {{ n }}" loading="lazy">
      </div>
    {% endfor %}
  </div>
</article>

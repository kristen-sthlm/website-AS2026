---
layout: base.njk
---

{% set padded = hymnnumber | pad3 %}
{% set t = strings[lang] %}

{# Find prev/next hymn in the sorted collection #}
{% set prevHymn = null %}
{% set nextHymn = null %}
{% set foundIdx = -1 %}
{% for h in collections.hymns %}
  {% if h.number == hymnnumber %}
    {% set foundIdx = loop.index0 %}
  {% endif %}
{% endfor %}
{% for h in collections.hymns %}
  {% if loop.index0 == foundIdx - 1 %}{% set prevHymn = h %}{% endif %}
  {% if loop.index0 == foundIdx + 1 %}{% set nextHymn = h %}{% endif %}
{% endfor %}

<article class="hymn-page"
         data-hymn="{{ hymnnumber }}"
         data-pagefind-body
         data-pagefind-filter="lang:{{ lang }}"
         data-pagefind-meta="title:Sång {{ hymnnumber }}">

  <div class="hymn-topbar">
    <a href="{{ '/' | url }}" class="icon-btn" aria-label="{{ t.home }}" title="{{ t.home }}">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 9.5L10 3l7 6.5V17a1 1 0 0 1-1 1h-3v-5H8v5H4a1 1 0 0 1-1-1V9.5z"/>
      </svg>
    </a>

    <div class="hymn-number-group">
      {% if prevHymn and prevHymn.languages[lang] %}
        <a href="{{ prevHymn.languages[lang].url | url }}" class="nav-arrow" aria-label="Föregående sång ({{ prevHymn.number }})" title="Föregående">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4l-6 6 6 6"/>
          </svg>
        </a>
      {% else %}
        <span class="nav-arrow is-disabled" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4l-6 6 6 6"/>
          </svg>
        </span>
      {% endif %}

      <input
        type="number"
        class="hymn-number-large"
        value="{{ hymnnumber }}"
        min="1"
        max="{{ collections.hymns.length }}"
        inputmode="numeric"
        pattern="[0-9]*"
        aria-label="Gå till sång"
        data-target="text"
        data-lang="{{ lang }}"
      >

      {% if nextHymn and nextHymn.languages[lang] %}
        <a href="{{ nextHymn.languages[lang].url | url }}" class="nav-arrow" aria-label="Nästa sång ({{ nextHymn.number }})" title="Nästa">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 4l6 6-6 6"/>
          </svg>
        </a>
      {% else %}
        <span class="nav-arrow is-disabled" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 4l6 6-6 6"/>
          </svg>
        </span>
      {% endif %}
    </div>

    <a href="{{ ('/hymns/' + padded + '-score/') | url }}" class="icon-btn" aria-label="{{ t.showScore }}" title="{{ t.showScore }}">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 3v12.5a2.5 2.5 0 1 0 1 1.95V7l8-2v8.5a2.5 2.5 0 1 0 1 1.95V3L5 5z"/>
      </svg>
    </a>
  </div>

  {# Get the Swedish first line for the player title #}
  {% set hymnTitle = '' %}
  {% for h in collections.hymns %}
    {% if h.number == hymnnumber and h.verses %}
      {% set hymnTitle = h.verses[0].firstLine %}
    {% endif %}
  {% endfor %}

  <section class="audio-section">
    <div class="player" data-src="{{ ('/hymns/audio/' + padded + '.mp3') | url }}" data-title="{{ hymnTitle }}">
      <div class="player-title" aria-hidden="true">{{ hymnTitle }}</div>
      <div class="player-row">
        <button type="button" class="player-play" aria-label="Spela">
          <svg class="player-icon-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M8 5.5v13a1 1 0 0 0 1.55.83l10-6.5a1 1 0 0 0 0-1.66l-10-6.5A1 1 0 0 0 8 5.5z"/>
          </svg>
          <svg class="player-icon-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <rect x="6" y="5" width="4.5" height="14" rx="1"/>
            <rect x="13.5" y="5" width="4.5" height="14" rx="1"/>
          </svg>
        </button>
        <div class="player-progress" role="slider" tabindex="0" aria-label="Spelningsläge" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="player-progress-track">
            <div class="player-progress-fill"></div>
            <div class="player-progress-thumb"></div>
          </div>
        </div>
        <div class="player-time">
          <span class="player-time-current">0:00</span>
          <span class="player-time-sep">/</span>
          <span class="player-time-total">—</span>
        </div>
        <button type="button" class="player-loop is-active" aria-label="Loop" aria-pressed="true" title="Upprepa">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 8a3 3 0 0 1 3-3h7l-2-2M15 12a3 3 0 0 1-3 3H5l2 2"/>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <nav class="lang-toggle" aria-label="{{ t.languageLabel }}">
    <a href="{{ ('/hymns/' + padded + '-sv/') | url }}" class="lang-btn{% if lang == 'sv' %} active{% endif %}">SV</a>
    <a href="{{ ('/hymns/' + padded + '-en/') | url }}" class="lang-btn{% if lang == 'en' %} active{% endif %}">EN</a>
    <a href="{{ ('/hymns/' + padded + '-fr/') | url }}" class="lang-btn{% if lang == 'fr' %} active{% endif %}">FR</a>
    <a href="{{ ('/hymns/' + padded + '-ar/') | url }}" class="lang-btn{% if lang == 'ar' %} active{% endif %}">AR</a>
  </nav>

  {% if lang != 'sv' and t.translationNotice %}
    {% if lang == 'ar' and t.translationNoticeMachine %}
      <p class="translation-notice" dir="rtl">{{ t.translationNotice }} {{ t.translationNoticeMachine }}</p>
    {% else %}
      <p class="translation-notice"{% if lang == 'ar' %} dir="rtl"{% endif %}>{{ t.translationNotice }}</p>
    {% endif %}
  {% endif %}

  <section class="lyrics{% if lang == 'ar' %} is-rtl{% endif %}"{% if lang == 'ar' %} dir="rtl"{% endif %}>
    {{ content | safe }}
  </section>

  {# Footnote always comes from the Swedish version, identical in all languages #}
  {% set svData = null %}
  {% for h in collections.hymns %}
    {% if h.number == hymnnumber and h.languages.sv %}
      {% set svData = h.languages.sv.data %}
    {% endif %}
  {% endfor %}

  {% if svData and svData.footnote %}
    <p class="hymn-footnote">{{ svData.footnote | inlineMarkdown | safe }}</p>
  {% endif %}

</article>

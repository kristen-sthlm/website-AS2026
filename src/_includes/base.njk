<!DOCTYPE html>
<html lang="{{ lang or 'sv' }}" data-base="{{ '/' | url }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f6f2ea" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)">
  <title>{{ title }}{% if title != site.title %} — {{ site.title }}{% endif %}</title>
  <link rel="stylesheet" href="{{ '/assets/fonts/fonts.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
{% set isHymnPage = page.url.indexOf('/hymns/') == 0 %}
<body class="{% if isHymnPage %}is-hymn-page{% endif %}">
  <div class="wip-banner" role="status">
    Webbplatsen är under uppbyggnad — ändringar och förbättringar pågår.
  </div>

  <main>
    {{ content | safe }}
  </main>

  {% if isHymnPage %}
    <script type="module" src="{{ '/assets/player.js' | url }}"></script>
  {% endif %}

  <footer class="site-footer">
    <nav class="footer-links" aria-label="Webbplatsinformation">
      <a href="{{ '/about/' | url }}">Om</a>
      <a href="{{ '/license/' | url }}">Licens</a>
      <a href="{{ '/privacy/' | url }}">Integritet</a>
      <a href="{{ '/legal/' | url }}">Rättsligt</a>
      <a href="https://tally.so/r/7R4MZz" target="_blank" rel="noopener">Kontakt ↗</a>
    </nav>
    <p class="footer-meta">
      <span>{{ site.title }}</span>
      <span class="footer-sep">·</span>
      <span>{{ site.publisher }}, {{ site.year }}</span>
      <span class="footer-sep">·</span>
      <span>{{ site.license }}</span>
    </p>
  </footer>
</body>
</html>
